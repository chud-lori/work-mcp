# Figma personal access token. Create a SCOPED token (read-only):
# Figma -> avatar -> Settings -> Security -> Personal access tokens -> Generate
# Scopes: folders:read, file_content:read, file_comments:read
FIGMA_API_TOKEN=

# Team whose projects and files this server can see. The number after /team/
# in your Figma team URL, e.g. https://www.figma.com/files/team/123456789/...
FIGMA_TEAM_ID=
