# OAuth desktop app credentials downloaded from Google Cloud Console.
GOOGLE_WORKSPACE_CREDENTIALS_FILE=/absolute/path/to/credentials.json

# OAuth token cache generated by the first auth flow.
GOOGLE_WORKSPACE_TOKEN_FILE=/absolute/path/to/token.json

# Optional: restrict all Drive/Docs/Sheets access to these folders and anything
# nested under them (subtree-aware). Comma-separated Drive folder IDs. When set,
# drive_search only returns files inside the allow-list, and reads of files
# outside it are denied. Gmail and Calendar are unaffected. Leave unset for full
# access to whatever the account can see.
# GOOGLE_WORKSPACE_ALLOWED_FOLDER_IDS=folder_id_1,folder_id_2
