# OAuth desktop app credentials downloaded from Google Cloud Console.
GOOGLE_WORKSPACE_CREDENTIALS_FILE=/absolute/path/to/credentials.json

# OAuth token cache generated by the first auth flow.
GOOGLE_WORKSPACE_TOKEN_FILE=/absolute/path/to/token.json

# Optional: restrict Drive search/listing to one shared drive or folder at application layer later.
# GOOGLE_WORKSPACE_ALLOWED_FOLDER_IDS=folder_id_1,folder_id_2
